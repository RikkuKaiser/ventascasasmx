# Número para el botón flotante de WhatsApp (solo dígitos, con lada país, sin +)
# Ejemplo México (celular): 521 + 10 dígitos (52 país, 1 móvil)
NUXT_PUBLIC_WHATSAPP_PHONE=5213326041567

# Mensaje opcional que se abre prellenado en el chat
# NUXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero información sobre un inmueble.

# Aviso de privacidad: correo ARCO / privacidad y domicilio del responsable
# NUXT_PUBLIC_RESPONSABLE_NOMBRE=LuxeInmuebles S.A. de C.V.
NUXT_PUBLIC_PRIVACIDAD_EMAIL=privacidad@tudominio.com
NUXT_PUBLIC_RESPONSABLE_DOMICILIO=Calle, número, colonia, alcaldía o municipio, ciudad, estado, C.P., México
